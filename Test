from pyspark.sql.functions import col, count, when, isnan, trim
from pyspark.sql.types import StringType, DoubleType, FloatType

def column_completeness(df, column_list):
    total_rows = df.count()
    if total_rows == 0: return df

    # Sütun tiplerini bir sözlük olarak alalım: {'sutun_adi': 'string', 'diger': 'int'}
    col_types = dict(df.dtypes)

    exprs = []
    for c in column_list:
        dtype = col_types[c]
        
        # 1. Temel şart: Her zaman null kontrolü yap
        condition = col(c).isNotNull()
        
        # 2. Eğer sayısal bir sütunsa NaN kontrolü ekle
        if dtype in ("double", "float"):
            condition = condition & (~isnan(col(c)))
            
        # 3. Eğer string bir sütunsa boş string kontrolü ekle
        if dtype == "string":
            condition = condition & (trim(col(c)) != "")

        # Bu sütun için ifadeyi listeye ekle
        exprs.append((count(when(condition, 1)) * 100 / total_rows).alias(c))

    # Tüm ifadeleri tek bir select içinde çalıştır
    return df.select(exprs)

